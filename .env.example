APP_ENV=development
# Development resolves backend/hospital_dss_dev.db to an absolute path.
# DATABASE_URL=postgresql+psycopg://hospital_user:change-me@localhost:5432/hospital_dss
POSTGRES_DB=hospital_dss
POSTGRES_USER=hospital_dss
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=8001
ALLOW_DEFAULT_DEV_USER=0
DEFAULT_DEV_USER_ID=super-admin
# Optional local-only bootstrap. Never set this in production.
DEV_SEED_PASSWORD=
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=icu-transfer-dss
AUTH_JWT_AUDIENCE=icu-transfer-web
AUTH_ACCESS_TOKEN_MINUTES=10
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SECURE=0
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
CORS_ALLOW_ORIGIN_REGEX=http://(127\.0\.0\.1|localhost):517[0-9]
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
RUN_MIGRATIONS=1
API_WORKERS=1
GOOGLE_MAPS_API_KEY=
FLEET_SIMULATION=1
OSM_GRAPH_ROUTING=1
OSM_GRAPH_PATH=
